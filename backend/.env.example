PORT=5000
MONGODB_URI=mongodb://localhost:27017/srilambo_vpn
JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_EXPIRES_IN=30d
NODE_ENV=development

# WireGuard server defaults (update these with your VPS details)
WG_SERVER_HOST=your-server-ip
WG_SERVER_PORT=51820
WG_SERVER_PUBLIC_KEY=your-server-public-key
WG_SERVER_PRIVATE_KEY=your-server-private-key
WG_DNS=1.1.1.1,1.0.0.1
WG_ALLOWED_IPS=0.0.0.0/0,::/0
